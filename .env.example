# Telegram credentials (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Provider priority is fixed: Clean APIs -> Gemini -> Groq -> OpenRouter
CLEANAPI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides. Check provider dashboards for currently available model IDs.
CLEANAPI_BASE_URL=https://cleanapis.com/v1
CLEANAPI_MODEL=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional
DATABASE_PATH=nexa_ai.sqlite3
MAX_ATTACHMENT_MB=15
MAX_ZIP_TEXT_CHARS=60000
MAX_HISTORY_MESSAGES=20
